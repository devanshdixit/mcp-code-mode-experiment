  "script": "async () => {\n  const [c] = (await crm.crm_search_customers({ query: \"Priya Shah\" }))\n    .filter(x => x.name === \"Priya Shah\");\n  const orders = await crm.crm_list_orders({ customer_id: c.id, since: \"2026-08-24\" });\n  const kept = orders.filter(o => o.status !== \"refunded\");\n  const total = kept.reduce((s, o) => s + o.subtotal, 0);\n  console.log(JSON.stringify({ customer: c.id, orders: kept.length, total: total.toFixed(2) }));\n}",
  "sampleTS": "/** Search issues using natural-language semantic matching. Best for conceptual or paraphrased queries (e.g. \"login fails after password reset\"). Already scoped to is:issue. */\nexport function search_issues(input: {\n  /** Subset of fields to return for each issue result. If omitted, all fields are returned. Use this to reduce response size when you only need specific fields; omitting 'body', 'reactions', and 'labels' in particular drops the largest per-result data. */\n  fields?: Array<\"number\" | \"title\" | \"body\" | \"state\" | \"state_reason\" | \"draft\" | \"locked\" | \"html_url\" | \"user\" | \"author_as"
